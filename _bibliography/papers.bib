@article{li2023elbo_landscape,
  title={Analysis of ELBO loss landscape},
  author={Li*, Ang, and Wei*, Xinyu},
  year={2023},
  url={https://arxiv.org/abs/2410.06170},
  abstract={We present a comprehensive empirical study of the Evidence Lower Bound (ELBO) loss landscape in variational inference, addressing fundamental questions about the geometric properties of its local minima and their connectivity. While prior work has suggested the existence of Maximum Energy Paths (MEPs) connecting local optima in the ELBO parameter space, systematic empirical validation remains incomplete. We adapt the string method to construct MEPs and introduce a novel visualization approach using random vector projection to analyze the ELBO landscape. Through extensive experiments on Latent Dirichlet Allocation with the AP dataset, we (1) provide the first empirical evidence for the existence of continuous high-energy paths between local minima, (2) demonstrate that these paths preserve semantic interpretability of topics, and (3) quantify the generalization performance of solutions along MEPs. Our findings reveal previously unknown geometric properties of the ELBO landscape and provide practical insights for initialization strategies in variational inference.},
  code={https://github.com/LeonLixyz/MetaLearn_CFD},
  selected={true},
  category={project},
  preview={elbo.png},
}
